-- One-time bootstrap, run manually against a fresh SQL Server instance
-- (local `mssql` container now; a separate host/VM later).
-- Not a Laravel migration: these are instance/login-level operations.
-- Generated as mssql-bootstrap.sql from this template with the app login
-- password substituted in from .secrets/db_app_password.txt — never commit
-- the generated file with a real password embedded; it is gitignored.

IF DB_ID(N'billingin') IS NULL
    CREATE DATABASE billingin;
GO

ALTER DATABASE billingin SET READ_COMMITTED_SNAPSHOT ON;
GO

USE billingin;
GO

IF NOT EXISTS (SELECT 1 FROM sys.server_principals WHERE name = N'billingin_app')
    CREATE LOGIN billingin_app WITH PASSWORD = N'__DB_APP_PASSWORD__', CHECK_POLICY = ON;
GO

IF NOT EXISTS (SELECT 1 FROM sys.database_principals WHERE name = N'billingin_app')
    CREATE USER billingin_app FOR LOGIN billingin_app;
GO

ALTER ROLE db_datareader ADD MEMBER billingin_app;
ALTER ROLE db_datawriter ADD MEMBER billingin_app;
ALTER ROLE db_ddladmin ADD MEMBER billingin_app;
GO

GRANT CREATE SCHEMA TO billingin_app;
GRANT CREATE FUNCTION TO billingin_app;
GRANT ALTER ANY SECURITY POLICY TO billingin_app;
GO
